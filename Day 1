-- FACT TABLE
CREATE TABLE sales_fact (
    order_id INT,
    product_id INT,
    customer_id INT,
    date_id INT,
    revenue FLOAT
);

-- DIMENSIONS
CREATE TABLE product_dim (
    product_id INT,
    product_name VARCHAR(100),
    category VARCHAR(50)
);

CREATE TABLE customer_dim (
    customer_id INT,
    customer_name VARCHAR(100),
    city VARCHAR(50)
);

CREATE TABLE date_dim (
    date_id INT,
    date DATE,
    month INT,
    year INT
);
SELECT p.category, SUM(f.revenue)
FROM sales_fact f
JOIN product_dim p ON f.product_id = p.product_id
GROUP BY p.category;


